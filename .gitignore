# Claude Code scratch — agent worktrees are transient, never versioned.
.claude/worktrees/

# local, machine-specific sweep config (config.example.json is the tracked copy)
tools/coderabbit-sweep/config.json

# Python bytecode
__pycache__/
*.pyc

# local, machine-specific PR dashboard config (config.example.json is the tracked copy)
tools/pr-dashboard/config.json
tools/pr-dashboard/dashboard.log*

# routines database: lives in ~/.nightforge by default, never versioned wherever it is put
*.db
*.db-wal
*.db-shm

# job-reports Worker: the real wrangler.toml names your D1 database; local dev state and secrets
tools/job-reports/wrangler.toml
tools/job-reports/.wrangler/
tools/job-reports/.dev.vars
tools/job-reports/node_modules/
